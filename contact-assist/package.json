{
  "name": "contact-assist",
  "version": "1.0.0",
  "private": true,
  "description": "お問い合わせフォーム半自動化・入力支援ローカルアプリ（調査・判断・入力支援のみ。入力・認証・送信は人間が行う）",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "tsx src/server/main.ts",
    "build": "vite build",
    "dev:ui": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "inspect": "tsx src/cli/inspect.ts",
    "sample:excel": "tsx src/cli/make-sample.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "playwright-core": "^1.49.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
